{"nodes": [{"id": "docs_harness_ablation_insights_document", "label": "Harness Ablation Study: Insights (document)", "file_type": "document", "source_file": "docs/HARNESS_ABLATION_INSIGHTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_harness_ablation_insights_run_a_with_harness", "label": "Run A \u2014 with harness", "file_type": "concept", "source_file": "docs/HARNESS_ABLATION_INSIGHTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Repo-level AGENTS.md, PROGRESS.md, verify.sh, and docs/software-principles.md were present; used to measure the harness's effect on the same task."}, {"id": "docs_harness_ablation_insights_run_b_without_harness", "label": "Run B \u2014 without repo harness", "file_type": "concept", "source_file": "docs/HARNESS_ABLATION_INSIGHTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only user-level Cursor rules and skills applied, isolating the repo harness as the removed variable."}, {"id": "docs_harness_ablation_insights_insight_1_discovery_time", "label": "Insight 1: Harness cost is discovery time, not implementation time", "file_type": "rationale", "source_file": "docs/HARNESS_ABLATION_INSIGHTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Explore-before-first-code was ~9 min with harness vs ~4 min without, almost the entire wall-time gap; the harness is a front-loaded, one-time comprehension tax that amortizes over repeated tasks."}, {"id": "docs_harness_ablation_insights_insight_2_user_level_skills", "label": "Insight 2: User-level skills/rules still impose structure without the harness", "file_type": "rationale", "source_file": "docs/HARNESS_ABLATION_INSIGHTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Run B still wrote loading/error states, tests, and a commit because Cursor user rules and skills persisted; the repo harness's distinctive contribution is narrower: compound components, PROGRESS.md, test-per-function granularity, and verify.sh."}, {"id": "docs_harness_ablation_insights_insight_3_verification_path", "label": "Insight 3: Verification gates are institutional memory", "file_type": "rationale", "source_file": "docs/HARNESS_ABLATION_INSIGHTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Run A had one known gate (verify.sh --lint-only) and one fix; Run B lacked verify.sh and hit 5 failing Jest runs re-discovering jest-expo/msw/pnpm config issues \u2014 losing a verification gate forces rediscovery of known-working tool-chain config."}, {"id": "docs_harness_ablation_insights_insight_4_compound_components_mandate", "label": "Insight 4: Architectural choices need explicit harness instructions", "file_type": "rationale", "source_file": "docs/HARNESS_ABLATION_INSIGHTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Run B, guided only by the react-native-patterns skill, defaulted to hooks + plain components; compound components appeared only because AGENTS.md explicitly mandated them, confirming the model has weak defaults for design patterns."}, {"id": "docs_harness_ablation_insights_insight_5_tool_call_distribution", "label": "Insight 5: Tool-call count is a weak proxy for effort", "file_type": "rationale", "source_file": "docs/HARNESS_ABLATION_INSIGHTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Total tool calls were similar (106 vs 116) but distribution differed: Run A skewed to Write/StrReplace/TodoWrite, Run B to Shell for live environment debugging \u2014 a working verification gate shifts effort from debugging to implementation."}, {"id": "docs_harness_ablation_insights_insight_6_scope_creep", "label": "Insight 6: Scope creep was not tested by this task", "file_type": "rationale", "source_file": "docs/HARNESS_ABLATION_INSIGHTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Neither run drifted into Step 2 despite vertical-slice guidance being present only in the harness; the prompt itself was scoped tightly enough that this guardrail wasn't stressed."}], "edges": [{"source": "docs_harness_ablation_insights_document", "target": "docs_harness_ablation_insights_run_a_with_harness", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/HARNESS_ABLATION_INSIGHTS.md", "source_location": null, "weight": 1.0}, {"source": "docs_harness_ablation_insights_document", "target": "docs_harness_ablation_insights_run_b_without_harness", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/HARNESS_ABLATION_INSIGHTS.md", "source_location": null, "weight": 1.0}, {"source": "docs_harness_ablation_insights_document", "target": "docs_harness_ablation_insights_insight_1_discovery_time", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/HARNESS_ABLATION_INSIGHTS.md", "source_location": null, "weight": 1.0}, {"source": "docs_harness_ablation_insights_document", "target": "docs_harness_ablation_insights_insight_2_user_level_skills", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/HARNESS_ABLATION_INSIGHTS.md", "source_location": null, "weight": 1.0}, {"source": "docs_harness_ablation_insights_document", "target": "docs_harness_ablation_insights_insight_3_verification_path", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/HARNESS_ABLATION_INSIGHTS.md", "source_location": 